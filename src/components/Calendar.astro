---
import { getCollection } from 'astro:content';

// 取出所有文章的日期信息,供日历标记使用
const posts = await getCollection('posts');

const calendarPosts = posts.map((p) => ({
  id: p.id,
  title: p.data.title,
  year: p.data.pubDate.getFullYear(),
  month: p.data.pubDate.getMonth() + 1,
  day: p.data.pubDate.getDate(),
  dateLabel: p.data.pubDate.toLocaleDateString('zh-CN'),
}));

const now = new Date();
const today = {
  y: now.getFullYear(),
  m: now.getMonth() + 1,
  d: now.getDate(),
};
---

<section class="calendar-card">
  <div class="calendar-header">
    <button class="calendar-nav-btn" id="cal-prev" aria-label="上个月">←</button>
    <h2 class="calendar-title" id="cal-title">日历</h2>
    <button class="calendar-nav-btn" id="cal-next" aria-label="下个月">→</button>
  </div>

  <div class="calendar-weekdays">
    <span>日</span><span>一</span><span>二</span><span>三</span>
    <span>四</span><span>五</span><span>六</span>
  </div>

  <div class="calendar-grid" id="cal-grid"></div>

  <div class="calendar-month-posts" id="cal-month-posts"></div>
</section>

<script define:vars={{ posts: calendarPosts, today }}>
  (function () {
    var grid = document.getElementById('cal-grid');
    var title = document.getElementById('cal-title');
    var monthBox = document.getElementById('cal-month-posts');
    if (!grid) return;

    // 按 "年-月-日" 建立索引
    var byDate = {};
    posts.forEach(function (p) {
      var key = p.year + '-' + p.month + '-' + p.day;
      (byDate[key] = byDate[key] || []).push(p);
    });

    // 初始展示:有文章的最近一个月,没有就展示当前月
    var latest = posts.slice().sort(function (a, b) {
      return b.year - a.year || b.month - a.month || b.day - a.day;
    })[0];

    var viewYear = latest ? latest.year : today.y;
    var viewMonth = latest ? latest.month : today.m;

    function render() {
      title.textContent = viewYear + ' 年 ' + viewMonth + ' 月';

      var firstDay = new Date(viewYear, viewMonth - 1, 1).getDay();
      var daysInMonth = new Date(viewYear, viewMonth, 0).getDate();
      var prevDays = new Date(viewYear, viewMonth - 1, 0).getDate();

      var html = '';

      // 上月补位
      for (var i = firstDay - 1; i >= 0; i--) {
        html += '<div class="cal-cell other"><span>' + (prevDays - i) + '</span></div>';
      }

      // 本月
      for (var d = 1; d <= daysInMonth; d++) {
        var key = viewYear + '-' + viewMonth + '-' + d;
        var hits = byDate[key];
        var cls = 'cal-cell';
        if (viewYear === today.y && viewMonth === today.m && d === today.d) cls += ' today';
        if (hits) cls += ' has-post';

        var inner = '<span class="cal-num">' + d + '</span>';
        if (hits) {
          inner += '<span class="cal-dot' + (hits.length > 1 ? ' multi' : '') + '"></span>';
          var tip = hits.map(function (p) { return p.title; }).join('、');
          var href = hits.length === 1 ? '/posts/' + hits[0].id + '/' : '/posts/';
          html += '<a class="' + cls + '" href="' + href + '" title="' + tip + '">' + inner + '</a>';
        } else {
          html += '<div class="' + cls + '">' + inner + '</div>';
        }
      }

      // 下月补位,凑满 7 的倍数
      var totalCells = firstDay + daysInMonth;
      var rest = (7 - (totalCells % 7)) % 7;
      for (var k = 1; k <= rest; k++) {
        html += '<div class="cal-cell other"><span>' + k + '</span></div>';
      }

      grid.innerHTML = html;

      // 本月文章列表
      var monthHits = posts
        .filter(function (p) { return p.year === viewYear && p.month === viewMonth; })
        .sort(function (a, b) { return b.day - a.day; });

      if (monthHits.length) {
        monthBox.innerHTML =
          '<div class="cal-month-title">本月文章 · ' + monthHits.length + ' 篇</div>' +
          monthHits.map(function (p) {
            return '<a class="cal-post-link" href="/posts/' + p.id + '/">' +
              '<span class="cal-post-date">' + p.month + '/' + p.day + '</span>' +
              '<span class="cal-post-name">' + p.title + '</span>' +
            '</a>';
          }).join('');
      } else {
        monthBox.innerHTML = '<div class="cal-month-empty">这个月还没有写文章～</div>';
      }
    }

    document.getElementById('cal-prev').addEventListener('click', function () {
      viewMonth--;
      if (viewMonth < 1) { viewMonth = 12; viewYear--; }
      render();
    });

    document.getElementById('cal-next').addEventListener('click', function () {
      viewMonth++;
      if (viewMonth > 12) { viewMonth = 1; viewYear++; }
      render();
    });

    render();
  })();
</script>
