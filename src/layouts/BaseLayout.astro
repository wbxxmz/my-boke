---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '一个用 Astro 搭建的个人博客',
}: Props = Astro.props;

const pageTitle = `${title} · wbxxmz 的博客`;

// 收集所有文章,供导航栏的分类下拉和搜索使用
const allPosts = await getCollection('posts');
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags))].sort();

// 构建搜索数据 JSON,注入到页面里
const searchData = allPosts.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  cover: p.data.cover ?? '',
  date: p.data.pubDate.toISOString().slice(0, 10),
  tags: p.data.tags,
}));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <script define:vars={{ data: searchData }}>
      window.__searchData = data;
    </script>

    <!-- 主题初始化:同步内联,在浏览器绘制前就确定深浅色,避免闪烁 -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('blog_theme');
        var prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
        var theme = saved || (prefersLight ? 'light' : 'dark');
        if (theme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="/" class="logo">wbxxmz 的博客</a>
        <div class="nav-links">
          <a href="/">首页</a>
          <a href="/posts/">文章</a>
          <div class="nav-dropdown">
            <button class="nav-dropdown-btn">分类 ▾</button>
            <div class="nav-dropdown-menu">
              {allTags.map((tag) => (
                <a href={`/tags/${tag}/`}>{tag}</a>
              ))}
            </div>
          </div>
          <a href="/about/">关于</a>
        </div>
        <div class="nav-search">
          <input
            type="text"
            id="search-input"
            placeholder="搜索文章..."
            autocomplete="off"
          />
          <div id="search-results" class="search-results"></div>
        </div>

        <!-- 深浅色模式切换 -->
        <button id="theme-toggle" class="theme-toggle" title="切换深浅色" aria-label="切换深浅色">
          <span class="theme-icon theme-icon-dark">🌙</span>
          <span class="theme-icon theme-icon-light">☀️</span>
        </button>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <p class="footer-copy">
          使用 <a href="https://astro.build/">Astro</a> 构建 · © 2026
        </p>
        <div class="footer-social">
          <a href="https://github.com/wbxxmz" target="_blank" rel="noopener" title="GitHub" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.73.5.5 5.73.5 12c0 5.08 3.29 9.38 7.86 10.9.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.35-1.3-1.7-1.3-1.7-1.06-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.76.41-1.27.74-1.56-2.55-.29-5.23-1.27-5.23-5.66 0-1.25.45-2.28 1.2-3.08-.12-.3-.52-1.47.11-3.07 0 0 .97-.31 3.18 1.18.92-.26 1.9-.38 2.88-.38.98 0 1.96.13 2.88.38 2.2-1.49 3.17-1.18 3.17-1.18.63 1.6.23 2.77.11 3.07.75.8 1.2 1.83 1.2 3.08 0 4.4-2.69 5.37-5.25 5.65.42.36.8 1.07.8 2.15v3.18c0 .31.21.67.8.56 4.56-1.52 7.85-5.82 7.85-10.9C23.5 5.73 18.27.5 12 .5z"/></svg>
          </a>
          <a href="mailto:your-email@example.com" title="邮箱" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>
          </a>
          <a href="/rss.xml" title="RSS 订阅" class="social-link">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/></svg>
          </a>
        </div>
      </div>
    </footer>

    <!-- 返回顶部按钮 -->
    <button id="back-to-top" class="back-to-top" aria-label="返回顶部">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
    </button>

    <!-- 搜索结果全屏遮罩层 -->
    <div id="search-overlay" class="search-overlay" aria-hidden="true">
      <div class="search-overlay-inner">
        <div class="search-overlay-header">
          <div class="search-overlay-title">
            搜索 <span class="search-overlay-query" id="search-overlay-query"></span>
            <span class="search-overlay-count" id="search-overlay-count">0</span> 个结果
          </div>
          <button class="search-overlay-close" id="search-overlay-close" aria-label="关闭">✕</button>
        </div>
        <div class="search-overlay-list" id="search-overlay-list"></div>
      </div>
    </div>

    <script>
      // ===== 主题切换(深色/浅色) =====
      const themeToggle = document.getElementById('theme-toggle');
      const applyTheme = (theme) => {
        if (theme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        } else {
          document.documentElement.removeAttribute('data-theme');
        }
        if (themeToggle) {
          themeToggle.classList.toggle('is-light', theme === 'light');
        }
      };
      // 初始化按钮图标
      const initialTheme = document.documentElement.getAttribute('data-theme') || 'dark';
      applyTheme(initialTheme);

      if (themeToggle) {
        themeToggle.addEventListener('click', () => {
          const isLight = document.documentElement.hasAttribute('data-theme');
          const next = isLight ? 'dark' : 'light';
          localStorage.setItem('blog_theme', next);
          applyTheme(next);
        });
      }

      // ===== 返回顶部按钮 =====
      const backToTop = document.getElementById('back-to-top');
      if (backToTop) {
        window.addEventListener('scroll', () => {
          if (window.scrollY > 400) {
            backToTop.classList.add('show');
          } else {
            backToTop.classList.remove('show');
          }
        });
        backToTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // ===== 搜索功能 =====
      const input = document.getElementById('search-input');
      const resultsBox = document.getElementById('search-results');
      const data = window.__searchData || [];

      // 检测一篇文章匹配了哪些字段
      function findMatchFields(p, q) {
        var fields = [];
        if (p.title.toLowerCase().includes(q)) fields.push('标题');
        if (p.description.toLowerCase().includes(q)) fields.push('摘要');
        if (p.tags.some(function (t) { return t.toLowerCase().includes(q); })) fields.push('标签');
        return fields;
      }

      // 把字符串里的关键词高亮
      function highlight(text, q) {
        if (!q) return text;
        var safe = q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        var re = new RegExp('(' + safe + ')', 'gi');
        return text.replace(re, '<mark class="search-hit">$1</mark>');
      }

      function openSearchOverlay(q) {
        var overlay = document.getElementById('search-overlay');
        var qDisplay = document.getElementById('search-overlay-query');
        var listBox = document.getElementById('search-overlay-list');
        var countBox = document.getElementById('search-overlay-count');
        if (!overlay) return;
        q = q.trim().toLowerCase();
        if (!q) return;
        var hits = [];
        data.forEach(function (p) {
          var fields = findMatchFields(p, q);
          if (fields.length) hits.push({ post: p, fields: fields });
        });
        qDisplay.textContent = q;
        countBox.textContent = hits.length;
        if (hits.length === 0) {
          listBox.innerHTML = '<div class="search-overlay-empty">没找到任何包含 <strong>' + q + '</strong> 的文章 😢</div>';
        } else {
          listBox.innerHTML = hits.map(function (h) {
            var p = h.post;
            var fieldTags = h.fields.map(function (f) {
              return '<span class="search-match-tag">匹配 · ' + f + '</span>';
            }).join('');
            return (
              '<a href="/posts/' + p.id + '/" class="search-overlay-item">' +
                '<div class="search-overlay-item-info">' +
                  '<div class="search-overlay-item-title">' + highlight(p.title, q) + '</div>' +
                  '<div class="search-overlay-item-desc">' + highlight(p.description, q) + '</div>' +
                  '<div class="search-overlay-item-meta">' +
                    '<time>' + p.date + '</time>' +
                    (p.tags.length ? '<span class="search-overlay-item-tags">' + p.tags.map(function (t) { return '#' + t; }).join(' ') + '</span>' : '') +
                    '<div class="search-overlay-item-fields">' + fieldTags + '</div>' +
                  '</div>' +
                '</div>' +
              '</a>'
            );
          }).join('');
        }
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }

      function closeSearchOverlay() {
        var overlay = document.getElementById('search-overlay');
        if (overlay) overlay.classList.remove('active');
        document.body.style.overflow = '';
      }

      // Enter 打开搜索结果遮罩
      if (input) {
        input.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            resultsBox.classList.remove('active');
            openSearchOverlay(input.value);
          } else if (e.key === 'Escape') {
            input.value = '';
            resultsBox.classList.remove('active');
            closeSearchOverlay();
          }
        });
      }

      // 实时下拉预览(保留)
      if (input && resultsBox) {
        input.addEventListener('input', () => {
          const q = input.value.trim().toLowerCase();
          if (!q) {
            resultsBox.innerHTML = '';
            resultsBox.classList.remove('active');
            return;
          }
          const matches = data.filter(
            (p) =>
              p.title.toLowerCase().includes(q) ||
              p.description.toLowerCase().includes(q) ||
              p.tags.some((t) => t.toLowerCase().includes(q)),
          ).slice(0, 8);

          if (matches.length === 0) {
            resultsBox.innerHTML = '<div class="search-empty">没找到相关文章(按 Enter 看完整结果)</div>';
          } else {
            resultsBox.innerHTML = matches
              .map(
                (p) => `
                <a href="/posts/${p.id}/" class="search-item">
                  ${p.cover ? `<img src="${p.cover}" alt="" />` : ''}
                  <div class="search-item-info">
                    <div class="search-item-title">${p.title}</div>
                    <div class="search-item-desc">${p.description}</div>
                  </div>
                </a>`,
              )
              .join('') +
              '<div class="search-hint">按 Enter 查看完整结果 →</div>';
          }
          resultsBox.classList.add('active');
        });

        // 点击外部关闭
        document.addEventListener('click', (e) => {
          if (!input.contains(e.target) && !resultsBox.contains(e.target)) {
            resultsBox.classList.remove('active');
          }
        });
      }

      // 点击遮罩关闭 + Escape 关闭
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeSearchOverlay();
      });
      document.addEventListener('click', function (e) {
        if (e.target && e.target.id === 'search-overlay') closeSearchOverlay();
        if (e.target && e.target.id === 'search-overlay-close') closeSearchOverlay();
      });

      // 分类下拉菜单点击切换
      const dropdownBtn = document.querySelector('.nav-dropdown-btn');
      const dropdownMenu = document.querySelector('.nav-dropdown-menu');
      if (dropdownBtn && dropdownMenu) {
        dropdownBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          dropdownMenu.classList.toggle('show');
        });
        document.addEventListener('click', () => {
          dropdownMenu.classList.remove('show');
        });
      }

      // ===== 全站页面跳转淡入淡出 =====
      (function () {
        var LEAVE_MS = 260;
        var leaving = false;

        document.addEventListener('click', function (e) {
          // 已被分页等自定义逻辑拦截的点击,不重复处理
          if (e.defaultPrevented) return;
          // 只响应鼠标左键,且没有按修饰键
          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

          var link = e.target.closest('a');
          if (!link) return;
          if (link.target === '_blank' || link.hasAttribute('download')) return;
          if (link.dataset.noTransition !== undefined) return;

          var href = link.getAttribute('href');
          if (!href || href.charAt(0) === '#') return;

          var url;
          try {
            url = new URL(link.href, location.href);
          } catch (err) {
            return;
          }
          // 只处理同源 http(s) 链接(排除 mailto、外链等)
          if (url.origin !== location.origin) return;
          if (url.protocol !== 'http:' && url.protocol !== 'https:') return;
          // 仅 hash 变化的链接交给浏览器原生处理
          if (
            url.pathname === location.pathname &&
            url.search === location.search &&
            url.hash
          ) {
            return;
          }

          e.preventDefault();
          if (leaving) return;
          leaving = true;
          document.body.classList.add('page-leaving');
          setTimeout(function () {
            location.href = link.href;
          }, LEAVE_MS);
        });

        // 浏览器前进/后退命中缓存时,确保淡出类已移除
        window.addEventListener('pageshow', function () {
          document.body.classList.remove('page-leaving');
          leaving = false;
        });
      })();
    </script>
  </body>
</html>
