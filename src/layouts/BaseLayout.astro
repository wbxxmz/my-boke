---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = '一个用 Astro 搭建的个人博客',
}: Props = Astro.props;

const pageTitle = `${title} · 我的博客`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav">
        <a href="/" class="logo">我的博客</a>
        <div class="nav-links">
          <a href="/">首页</a>
          <a href="/about/">关于</a>
        </div>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        使用 <a href="https://astro.build/">Astro</a> 构建 · © 2026
      </p>
    </footer>
  </body>
</html>
