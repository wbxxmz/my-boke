---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  return posts.map((post) => ({
    params: { id: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article" data-post-id={post.id}>
    <h1>{post.data.title}</h1>
    <time datetime={post.data.pubDate.toISOString()}>
      发布于 {post.data.pubDate.toLocaleDateString('zh-CN')}
    </time>
    <Content />
  </article>
</BaseLayout>

<script is:inline define:vars={{ pid: post.id }}>
  (function () {
    var KEY = 'blog_view_counts';
    var counts = {};
    try { counts = JSON.parse(localStorage.getItem(KEY) || '{}'); } catch (e) {}
    counts[pid] = (counts[pid] || 0) + 1;
    try { localStorage.setItem(KEY, JSON.stringify(counts)); } catch (e) {}
  })();
</script>
