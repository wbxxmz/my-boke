---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 传给客户端 JS 用于排序和渲染
const postsData = allPosts.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  pubDate: p.data.pubDate.toLocaleDateString('zh-CN'),
  cover: p.data.cover || '',
  coverFit: p.data.coverFit || '',
  coverPosition: p.data.coverPosition || '',
  tags: p.data.tags || [],
}));
---

<BaseLayout title="首页">
  <!-- 欢迎封面层 -->
  <section id="hero-overlay" class="hero-overlay">
    <div class="hero-content">
      <div class="hero-icon">✦</div>
      <h1 class="hero-title">欢迎来到 wbxxmz 的博客</h1>
      <p class="hero-subtitle">记录学习与生活的治愈角落 ✦</p>
      <div class="hero-buttons">
        <button class="hero-btn hero-btn-primary" id="hero-start">开始阅读</button>
        <a href="/about/" class="hero-btn hero-btn-secondary">关于我</a>
      </div>
    </div>
  </section>

  <!-- 首页内容:热门文章推荐 -->
  <section id="blog-content" class="blog-content home-popular-wrap">
    <h1 class="page-title" style="margin-top: 1rem;">热门推荐</h1>
    <p class="home-popular-tip">点击量最高的文章,大家都在看 ✦</p>
    <div id="popular-list" class="post-list"></div>
    <a href="/posts/" class="view-all-link">查看全部文章 →</a>
  </section>

  <!-- 同步内联脚本:浏览器绘制前确定 hero 状态,零闪烁 -->
  <script is:inline>
    (function () {
      var dismissed = sessionStorage.getItem('blog_hero_dismissed');
      var hero = document.getElementById('hero-overlay');
      var blog = document.getElementById('blog-content');
      if (dismissed) {
        if (hero) hero.classList.add('hidden');
        if (blog) blog.classList.add('visible');
      }
    })();
  </script>
</BaseLayout>

<script define:vars={{ posts: postsData }}>
  (function () {
    var KEY = 'blog_view_counts';
    var list = document.getElementById('popular-list');
    if (!list) return;

    // 读取点击量
    var counts = {};
    try {
      counts = JSON.parse(localStorage.getItem(KEY) || '{}');
    } catch (e) {}

    // 按点击量排序,没点击量的按时间倒序排在后面
    var sorted = posts.slice().sort(function (a, b) {
      var ca = counts[a.id] || 0;
      var cb = counts[b.id] || 0;
      if (cb !== ca) return cb - ca;
      return 0; // 保持原数组顺序(已按时间倒序)
    });

    // 展示前 5 篇
    var top = sorted.slice(0, 5);

    list.innerHTML = top.map(function (p, i) {
      var views = counts[p.id] || 0;
      var rank = i + 1;
      var coverHtml = '';
      if (p.cover) {
        var styleStr = '';
        if (p.coverFit) styleStr += 'object-fit:' + p.coverFit + ';';
        if (p.coverPosition) styleStr += 'object-position:' + p.coverPosition + ';';
        coverHtml = '<a href="/posts/' + p.id + '/" class="post-cover">' +
          '<img src="' + p.cover + '" alt="' + p.title + '" loading="lazy" style="' + styleStr + '" />' +
        '</a>';
      }
      return '<li class="post-item popular-item' + (p.cover ? ' has-cover' : '') + '">' +
        '<span class="popular-rank rank-' + rank + '">' + rank + '</span>' +
        coverHtml +
        '<div class="post-info">' +
          '<h2><a href="/posts/' + p.id + '/">' + p.title + '</a></h2>' +
          '<p class="post-meta">' +
            '<time>' + p.pubDate + '</time>' +
            (views > 0 ? '<span class="popular-views">👁 ' + views + ' 次阅读</span>' : '') +
          '</p>' +
          '<p class="post-excerpt">' + p.description + '</p>' +
        '</div>' +
      '</li>';
    }).join('');
  })();
</script>

<script>
  // ===== 欢迎页交互 =====
  var KEY = 'blog_hero_dismissed';

  var overlay = document.getElementById('hero-overlay');
  var btn = document.getElementById('hero-start');
  var blog = document.getElementById('blog-content');

  if (overlay && btn && blog) {
    btn.addEventListener('click', function () {
      sessionStorage.setItem(KEY, '1');
      overlay.classList.add('hidden');
      blog.classList.add('visible');
      setTimeout(function () {
        blog.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 300);
    });
  }
</script>
