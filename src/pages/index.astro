---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const allPosts = (await getCollection('posts')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// 传给客户端 JS 用于渲染
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const postsData = allPosts.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description,
  pubDate: p.data.pubDate.toLocaleDateString('zh-CN'),
  cover: p.data.cover ? p.data.cover.replace(/^\//, '') : '',
  coverFit: p.data.coverFit || '',
  coverPosition: p.data.coverPosition || '',
  tags: p.data.tags || [],
}));
---

<BaseLayout title="首页">
  <!-- 欢迎封面层 -->
  <section id="hero-overlay" class="hero-overlay">
    <div class="hero-content">
      <div class="hero-icon">✦</div>
      <h1 class="hero-title">欢迎来到 wbxxmz 的博客</h1>
      <p class="hero-subtitle">记录学习与生活的治愈角落 ✦</p>
      <div class="hero-buttons">
        <button class="hero-btn hero-btn-primary" id="hero-start">开始阅读</button>
        <a href={`${base}about/`} class="hero-btn hero-btn-secondary">关于我</a>
      </div>
    </div>
  </section>

  <!-- 首页内容:最新文章 -->
  <section id="blog-content" class="blog-content home-popular-wrap">
    <h1 class="page-title" style="margin-top: 1rem;">最新文章</h1>
    <p class="home-popular-tip">按发布时间排列的最新内容</p>
    <div id="popular-list" class="post-list"></div>
    <a href={`${base}posts/`} class="view-all-link">查看全部文章 →</a>
  </section>

  <!-- 同步内联脚本:浏览器绘制前确定 hero 状态,零闪烁 -->
  <script is:inline>
    (function () {
      var dismissed = sessionStorage.getItem('blog_hero_dismissed');
      var hero = document.getElementById('hero-overlay');
      var blog = document.getElementById('blog-content');
      if (dismissed) {
        if (hero) hero.classList.add('hidden');
        if (blog) blog.classList.add('visible');
      }
    })();
  </script>
</BaseLayout>

<script define:vars={{ posts: postsData, BASE: base }}>
  (function () {
    var list = document.getElementById('popular-list');
    if (!list) return;

    // 直接取发布时间最新的前 5 篇（frontmatter 已按 pubDate 倒序）
    var latest = posts.slice(0, 5);

    list.innerHTML = latest.map(function (p, i) {
      var rank = i + 1;
      var coverHtml = '';
      if (p.cover) {
        var styleStr = '';
        if (p.coverFit) styleStr += 'object-fit:' + p.coverFit + ';';
        if (p.coverPosition) styleStr += 'object-position:' + p.coverPosition + ';';
        coverHtml = '<a href="' + BASE + 'posts/' + p.id + '/" class="post-cover">' +
          '<img src="' + BASE + p.cover + '" alt="' + p.title + '" loading="lazy" style="' + styleStr + '" />' +
        '</a>';
      }
      var tagsHtml = '';
      if (p.tags && p.tags.length > 0) {
        tagsHtml = '<div class="post-card-tags">' +
          p.tags.map(function (t) { return '<span class="post-card-tag">#' + t + '</span>'; }).join('') +
        '</div>';
      }
      return '<li class="post-item popular-item' + (p.cover ? ' has-cover' : '') + '">' +
        '<span class="popular-rank rank-' + rank + '">' + rank + '</span>' +
        coverHtml +
        '<div class="post-info">' +
          '<h2><a href="' + BASE + 'posts/' + p.id + '/">' + p.title + '</a></h2>' +
          '<p class="post-meta">' +
            '<time>' + p.pubDate + '</time>' +
          '</p>' +
          '<p class="post-excerpt">' + p.description + '</p>' +
          tagsHtml +
        '</div>' +
      '</li>';
    }).join('');
  })();
</script>

<script>
  // ===== 欢迎页交互 =====
  var KEY = 'blog_hero_dismissed';

  var overlay = document.getElementById('hero-overlay');
  var btn = document.getElementById('hero-start');
  var blog = document.getElementById('blog-content');

  if (overlay && btn && blog) {
    btn.addEventListener('click', function () {
      sessionStorage.setItem(KEY, '1');
      overlay.classList.add('hidden');
      blog.classList.add('visible');
      setTimeout(function () {
        blog.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 300);
    });
  }
</script>
